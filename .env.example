OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...            # optional; disable with WEB_SEARCH_ENABLED=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scrag

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

RETRIEVE_K=6
SUFFICIENCY_RATIO=0.5
MAX_ATTEMPTS=3
WEB_SEARCH_ENABLED=true
